{
  "name": "template",
  "version": "2.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"core/**/*.ts\"",
    "start": "nest start user",
    "start:dev": "nest start user --watch",
    "start:debug": "nest start user --debug --watch",
    "start:prod": "node dist/apps/user/main",
    "start:trade": "nest start trade",
    "start:trade:dev": "nest start trade --watch",
    "lint": "eslint \"{apps,core,tests}/**/*.ts\" --fix",
    "test:unit": "jest --config .jestrc.json",
    "test:cov": "jest --coverage",
    "test:e2e": "jest -i --config jest-e2e.json",
    "test:load:user:create": "artillery run tests/user/create-user/create-user.artillery.yaml",
    "depcruise": "depcruise",
    "deps:validate": "depcruise apps/user/src --config .dependency-cruiser.js --output-type err-long",
    "deps:graph": "depcruise apps/user/src --include-only \"^apps/user/src\" --config .dependency-cruiser.js --output-type dot > assets/dependency-graph.dot"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/graphql": "^13.4.0",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "graphql": "^16.14.0",
    "helmet": "^8.1.0",
    "nanoid": "^5.1.11",
    "nestjs-console": "^10.0.0",
    "nestjs-request-context": "^4.0.0",
    "oxide.ts": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slonik": "^48.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "artillery": "^2.0.31",
    "artillery-plugin-faker": "^6.0.1",
    "dependency-cruiser": "^17.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jest-cucumber": "^4.5.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-essentials": "^10.2.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "preset": "ts-jest",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/core/"
    ],
    "moduleNameMapper": {
      "^@user/(.*)$": "<rootDir>/apps/user/src/$1",
      "^@trade/(.*)$": "<rootDir>/apps/trade/src/$1",
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@core$": "<rootDir>/core/index.ts",
      "^@tests/(.*)$": "<rootDir>/tests/$1"
    }
  }
}
