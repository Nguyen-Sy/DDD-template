{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/user/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/user/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/user",
  "projects": {
    "core": {
      "type": "library",
      "root": "core",
      "entryFile": "index",
      "sourceRoot": "core",
      "compilerOptions": {
        "tsConfigPath": "core/tsconfig.lib.json"
      }
    },
    "trade": {
      "type": "application",
      "root": "apps/trade",
      "entryFile": "main",
      "sourceRoot": "apps/trade/src",
      "compilerOptions": {
        "tsConfigPath": "apps/trade/tsconfig.app.json"
      }
    },
    "user": {
      "type": "application",
      "root": "apps/user",
      "entryFile": "main",
      "sourceRoot": "apps/user/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user/tsconfig.app.json"
      }
    }
  }
}